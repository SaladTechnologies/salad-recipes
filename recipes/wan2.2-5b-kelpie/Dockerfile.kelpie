FROM scratch AS kelpie
ARG KELPIE_VERSION=0.7.2
ADD --chmod=0755 --checksum=sha256:a0b98e9d44fb4ebbe3b8267e7545616a6814f9b07f9757e00ca84037b73f20f8 https://github.com/SaladTechnologies/kelpie/releases/download/${KELPIE_VERSION}/kelpie /kelpie

# Preserve the cons-1.0.0 runtime; replace only the Kelpie worker.
FROM saladtechnologies/wan2.2-5b-kelpie@sha256:f27acfccec7dfaeb3d6105b9bc107226ab91fbab969c3e60782d5939f87d877a
COPY --link --from=kelpie /kelpie /usr/local/bin/kelpie
